# Per-machine TLS trust store override. Created when the local JDK
# can't validate Maven/Google certs because antivirus (Avast,
# Kaspersky, ESET, etc.) or a corporate proxy intercepts HTTPS and
# re-signs every response with a private root CA. Each install of
# Avast generates its own root, so this file is machine-specific
# and must NOT be committed. See `android/setup-cacerts.ps1` to
# (re)generate it.
cacerts.local

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
